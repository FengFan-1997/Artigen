{
  "name": "artigen",
  "version": "1.0.0",
  "private": true,
  "description": "Artigen creator workshop and media tools",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter backend dev\" \"pnpm --filter personal dev\"",
    "build": "pnpm --filter personal build",
    "lint": "pnpm --filter personal lint && pnpm --filter backend lint && pnpm --filter artigen-mail-relay lint",
    "lint:fix": "pnpm --filter personal lint:fix",
    "type-check": "pnpm --filter personal type-check",
    "test": "pnpm test:unit && pnpm test:backend && pnpm test:mail-relay",
    "test:unit": "pnpm --filter personal test",
    "test:backend": "pnpm --filter backend test",
    "test:mail-relay": "pnpm --filter artigen-mail-relay test",
    "eval:agent:validate": "pnpm --filter backend eval:agent:validate",
    "eval:agent:deterministic": "pnpm --filter backend eval:agent:deterministic",
    "eval:agent:live": "pnpm --filter backend eval:agent:live",
    "eval:agent:live:gate": "pnpm --filter backend eval:agent:live:gate",
    "eval:agent:live:prepare-review": "pnpm --filter backend eval:agent:live:prepare-review",
    "eval:agent:live:score": "pnpm --filter backend eval:agent:live:score",
    "eval:agent:live:finalize": "pnpm --filter backend eval:agent:live:finalize",
    "test:agent:chaos": "pnpm --filter backend test:agent:chaos",
    "doctor:agent": "pnpm --filter backend doctor:agent",
    "build:cua-image": "docker build --progress=plain --pull=false -f backend/agent_runtime/Dockerfile.cua-local -t artigen/cua-xfce:0.1.15-tools-v2 backend/agent_runtime",
    "test:integration": "pnpm --filter personal test:e2e",
    "check:workspace": "node scripts/check-workspace-lockfile.mjs",
    "check:core": "pnpm check:workspace && pnpm lint && pnpm type-check && pnpm test && pnpm eval:agent:validate && pnpm build && pnpm --filter personal test:budget",
    "check": "pnpm check:core && pnpm test:integration",
    "install:all": "pnpm install --frozen-lockfile",
    "start": "pnpm --filter backend start",
    "start:agent-worker": "pnpm --filter backend start:agent-worker",
    "start:production": "pnpm --filter backend start:production",
    "db:migrate:locked": "pnpm --filter backend db:migrate:locked",
    "db:local:setup": "pnpm --filter backend db:local:setup",
    "db:backup:neon": "pnpm --filter backend db:backup:neon",
    "db:restore:verify": "pnpm --filter backend db:restore:verify",
    "db:audit": "pnpm --filter backend db:audit",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,vue,ts,tsx}": [
      "eslint --config frontend/eslint.config.js"
    ]
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.18",
      "brace-expansion@5": "5.0.9",
      "fast-uri@3": "3.1.5",
      "nanoid@3": "3.3.18",
      "postcss@8": "8.5.23"
    }
  }
}
