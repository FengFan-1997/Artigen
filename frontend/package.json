{
  "name": "personal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "start": "sh -c 'serve -s dist -l ${PORT:-8080}'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "type-check": "vue-tsc -b",
    "test": "vitest run",
    "test:budget": "node scripts/check-initial-budget.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@jsquash/webp": "^1.5.0",
    "ant-design-vue": "^4.2.6",
    "echarts": "^6.0.0",
    "fabric": "7.4.0",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "gsap": "^3.13.0",
    "pdfjs-dist": "^4.10.38",
    "pinia": "^2.3.0",
    "serve": "^14.2.4",
    "vue": "^3.5.24",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.17.0",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "less": "^4.4.2",
    "prettier": "^3.7.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.1.10"
  }
}
