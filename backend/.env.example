# Runtime
NODE_ENV=development
APP_ENV=development
PORT=8080
TRUST_PROXY=0
APP_ORIGIN=http://localhost:4000
CORS_ORIGINS=http://localhost:4000
# Optional HTTP Basic gate for a public DEV deployment. Leave blank locally
# and in production; use a unique generated password only in the DEV service.
DEV_ACCESS_USERNAME=artigen-dev
DEV_ACCESS_PASSWORD=
# Render injects this at frontend build time.
VITE_TURNSTILE_SITE_KEY=
# Product page-view/click collection is enabled by default. Set to 0 only for
# an explicitly analytics-free build.
VITE_ANALYTICS_ENABLED=1

# Google Identity Services. The frontend reads this value from
# /api/auth/google/config so token rendering and audience verification match.
GOOGLE_OAUTH_CLIENT_ID=

# PostgreSQL 16
DATABASE_URL=postgresql://artigen:artigen_dev@127.0.0.1:5432/artigen_dev?sslmode=disable
# Use a direct (non-pooler) URL when production migrations need a separate connection.
DATABASE_MIGRATION_URL=
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000
# Homebrew keg-only example: /opt/homebrew/opt/postgresql@16/bin
PG_BIN_DIR=
PG_SSL_REJECT_UNAUTHORIZED=1
# PG_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# PG_SSL_CA_BASE64=
MIGRATION_LOCK_TIMEOUT_MS=120000
MIGRATION_LOCK_POLL_MS=1000

# Local PostgreSQL 16 setup (development only)
LOCAL_PG_ADMIN_URL=postgresql://127.0.0.1/postgres?sslmode=disable
LOCAL_PG_USER=artigen
LOCAL_PG_PASSWORD=artigen_dev
LOCAL_PG_DATABASE=artigen_dev
LOCAL_PG_TEST_DATABASE=artigen_test
LOCAL_PG_VERIFY_DATABASE=artigen_restore_verify
TEST_DATABASE_URL=postgresql://artigen:artigen_dev@127.0.0.1:5432/artigen_test?sslmode=disable

# Neon backup/restore drill
# Prefer a direct Neon URL. Backups default to ~/Library/Application Support/Artigen/backups.
NEON_DATABASE_URL=
NEON_BACKUP_DIR=
# This must be a disposable database whose name includes verify/restore/drill.
# RESTORE_VERIFY_DATABASE_URL is the preferred name; NEON_VERIFY_DATABASE_URL remains a compatibility alias.
RESTORE_VERIFY_DATABASE_URL=
NEON_VERIFY_DATABASE_URL=
NEON_VERIFY_ALLOW_RESET=0
# Optional explicit read-only audit target. Falls back to the restore URL, then DATABASE_URL.
AUDIT_DATABASE_URL=

# Production security (generate independent random values; never commit them)
PAID_FEATURES_ENABLED=false
PAYMENTS_ENABLED=false
CSRF_SECRET=
OTP_HMAC_SECRET=
SESSION_TOKEN_HASH_SECRET=
CONSOLE_ADMIN_USERNAME=
CONSOLE_ADMIN_PASSWORD=
CONSOLE_ADMIN_TOKEN_SECRET=
SESSION_NOT_BEFORE=
# Privacy-bounded product behavior retention. Allowed range: 7-365 days.
BEHAVIOR_EVENT_RETENTION_DAYS=90
# Maximum expired rows removed by one hourly opportunistic cleanup.
BEHAVIOR_EVENT_PURGE_BATCH_SIZE=5000

# Task queue and paid generation (kept disabled until database/provider/storage smoke tests pass)
AI_DESIGN_TASK_V2_ENABLED=false
WORKSHOP_AI_TASK_V2_ENABLED=false
AI_DESIGN_TASK_V2_ROLLOUT_PERCENT=0
TASK_PAYLOAD_ENCRYPTION_KEY=
# Keep legacy in production until staging smoke tests pass. CI uses pgboss.
TASK_QUEUE_DRIVER=legacy
TASK_QUEUE_CONCURRENCY=2
TASK_WORKER_ENABLED=0
TASK_LEASE_MS=90000
TASK_HEARTBEAT_MS=20000
TASK_QUEUE_POLL_MS=1000
TASK_QUEUE_RETRY_DELAY_SECONDS=15
TASK_QUEUE_EXPIRE_SECONDS=900
PGBOSS_SCHEMA=pgboss
PGBOSS_POOL_MAX=5
PGBOSS_LISTEN_NOTIFY=1
SILICONFLOW_API_KEY=
AI_DESIGN_SILICONFLOW_TEXT_MODEL=Kwai-Kolors/Kolors
# Reference-image generation is intentionally disabled; do not configure an edit model.
AI_DESIGN_SILICONFLOW_EDIT_MODEL=
AI_DESIGN_SILICONFLOW_DIRECTIONS_MODEL=Qwen/Qwen3-8B

# Shared object storage is mandatory before enabling paid image generation.
ASSET_STORAGE_DRIVER=file
ASSET_FILE_ROOT=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=0
# Keep disabled until the S3/R2 staging smoke test passes.
DIRECT_ASSET_UPLOADS=0

# Production email OTP uses a signed HTTPS relay. Render never connects to SMTP directly.
# Brevo remains supported as an optional alternative.
AUTH_EMAIL_OTP_ENABLED=false
MAIL_PROVIDER=relay
MAIL_RELAY_URL=
MAIL_RELAY_SHARED_SECRET=
BREVO_API_KEY=
MAIL_FROM_EMAIL=sorates1997@163.com
MAIL_FROM_NAME=Artigen
MAIL_TIMEOUT_MS=8000
TURNSTILE_REQUIRED=false
TURNSTILE_SECRET_KEY=
# Local development may use localhost. Production requires the exact public
# FQDN from APP_ORIGIN, with no scheme, port, path, wildcard or IP address.
TURNSTILE_HOSTNAMES=localhost

# Optional local-only SMTP fallback. Production deliberately rejects direct SMTP delivery.
QQ_SMTP_USER=
QQ_SMTP_PASS=
QQ_SMTP_HOST=smtp.qq.com
QQ_SMTP_PORT=465
QQ_SMTP_SECURE=true
QQ_SMTP_FROM_NAME=Artigen

# Payment provider (leave paid features disabled until webhook fixtures and staging smoke pass)
AFDIAN_API_USER_ID=
AFDIAN_API_TOKEN=
# The documented Afdian webhook is unsigned. Keep this at 0 and rely on the
# mandatory token-authenticated query-order verification. Set to 1 only if
# Afdian explicitly enables RSA signatures for this creator account.
AFDIAN_WEBHOOK_REQUIRE_SIGN=0
AFDIAN_WEBHOOK_PUBLIC_KEY=
AFDIAN_PACKAGE_PLAN_ID_MAP=
AFDIAN_PACKAGE_PAY_URL_MAP=
