# Runtime
NODE_ENV=development
APP_ENV=development
PORT=8080
TRUST_PROXY=0
APP_ORIGIN=http://localhost:4000
CORS_ORIGINS=http://localhost:4000
# Optional HTTP Basic gate for a public DEV deployment. Leave blank locally
# and in production; use a unique generated password only in the DEV service.
DEV_ACCESS_USERNAME=artigen-dev
DEV_ACCESS_PASSWORD=
DEV_ACCESS_COOKIE_TTL_HOURS=12
# Render injects this at frontend build time.
VITE_TURNSTILE_SITE_KEY=
# Product page-view/click collection is enabled by default. Set to 0 only for
# an explicitly analytics-free build.
VITE_ANALYTICS_ENABLED=1

# Google Identity Services. The frontend reads this value from
# /api/auth/google/config so token rendering and audience verification match.
GOOGLE_OAUTH_CLIENT_ID=

# PostgreSQL 16 for local development and production. Hosted DEV uses the
# separate Aiven Free PostgreSQL 18 boundary below.
DATABASE_URL=postgresql://artigen:artigen_dev@127.0.0.1:5432/artigen_dev?sslmode=disable
# Use a direct (non-pooler) URL when production migrations need a separate connection.
DATABASE_MIGRATION_URL=
# DEV only: exact reviewed Aiven hostname; startup rejects any other target.
DEV_DATABASE_EXPECTED_HOST=
# DEV only: Aiven Free currently provisions PostgreSQL 18. Production remains 16.
DEV_DATABASE_EXPECTED_MAJOR=18
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=10000
# Homebrew keg-only example: /opt/homebrew/opt/postgresql@16/bin
PG_BIN_DIR=
PG_SSL_REQUIRED=0
PG_SSL_REJECT_UNAUTHORIZED=1
# PG_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# PG_SSL_CA_BASE64=
MIGRATION_LOCK_TIMEOUT_MS=120000
MIGRATION_LOCK_POLL_MS=1000

# Local PostgreSQL 16 setup (development only)
LOCAL_PG_ADMIN_URL=postgresql://127.0.0.1/postgres?sslmode=disable
LOCAL_PG_USER=artigen
LOCAL_PG_PASSWORD=artigen_dev
LOCAL_PG_DATABASE=artigen_dev
LOCAL_PG_TEST_DATABASE=artigen_test
LOCAL_PG_VERIFY_DATABASE=artigen_restore_verify
TEST_DATABASE_URL=postgresql://artigen:artigen_dev@127.0.0.1:5432/artigen_test?sslmode=disable

# Neon backup/restore drill
# Prefer a direct Neon URL. Backups default to ~/Library/Application Support/Artigen/backups.
NEON_DATABASE_URL=
NEON_BACKUP_DIR=
# This must be a disposable database whose name includes verify/restore/drill.
# RESTORE_VERIFY_DATABASE_URL is the preferred name; NEON_VERIFY_DATABASE_URL remains a compatibility alias.
RESTORE_VERIFY_DATABASE_URL=
NEON_VERIFY_DATABASE_URL=
NEON_VERIFY_ALLOW_RESET=0
# Optional explicit read-only audit target. Falls back to the restore URL, then DATABASE_URL.
AUDIT_DATABASE_URL=

# Production security (generate independent random values; never commit them)
PAID_FEATURES_ENABLED=false
PAYMENTS_ENABLED=false
CSRF_SECRET=
OTP_HMAC_SECRET=
SESSION_TOKEN_HASH_SECRET=
CONSOLE_ADMIN_USERNAME=
CONSOLE_ADMIN_PASSWORD=
CONSOLE_ADMIN_TOKEN_SECRET=
SESSION_NOT_BEFORE=
# Privacy-bounded product behavior retention. Allowed range: 7-365 days.
BEHAVIOR_ANALYTICS_ENABLED=true
BEHAVIOR_EVENT_RETENTION_DAYS=90
# Scheduled cleanup cadence, rows per batch, and maximum batches per run.
BEHAVIOR_EVENT_PURGE_INTERVAL_MS=3600000
BEHAVIOR_EVENT_PURGE_BATCH_SIZE=5000
BEHAVIOR_EVENT_PURGE_MAX_BATCHES=20

# Task queue and paid generation (kept disabled until database/provider/storage smoke tests pass)
AI_DESIGN_TASK_V2_ENABLED=false
WORKSHOP_AI_TASK_V2_ENABLED=false
AI_DESIGN_TASK_V2_ROLLOUT_PERCENT=0
TASK_PAYLOAD_ENCRYPTION_KEY=
# Keep legacy in production until staging smoke tests pass. CI uses pgboss.
TASK_QUEUE_DRIVER=legacy
TASK_QUEUE_CONCURRENCY=2
TASK_WORKER_ENABLED=0
TASK_LEASE_MS=90000
TASK_HEARTBEAT_MS=20000
TASK_QUEUE_POLL_MS=1000
TASK_QUEUE_RETRY_DELAY_SECONDS=15
TASK_QUEUE_EXPIRE_SECONDS=900
PGBOSS_SCHEMA=pgboss
PGBOSS_POOL_MAX=5
PGBOSS_LISTEN_NOTIFY=1
SILICONFLOW_API_KEY=
# Optional macOS-only local secret source. Production deployments should keep
# using SILICONFLOW_API_KEY in the platform secret manager.
SILICONFLOW_KEYCHAIN_SERVICE=
SILICONFLOW_KEYCHAIN_ACCOUNT=
# Generation model IDs are fixed in server code and are never client-controlled.
AI_DESIGN_GENERATE_COST_MINOR=
AI_DESIGN_REFERENCE_COST_MINOR=30
AI_DESIGN_DIRECTIONS_COST_MINOR=

# Agent Beta. Keep both gates off until migration 019, the dedicated worker,
# SiliconFlow/Cua probes, and a real artifact smoke test pass.
AGENT_FEATURE_ENABLED=false
AGENT_WORKER_ENABLED=0
AGENT_RUNTIME_DRIVER=live
# Reuses the SILICONFLOW_API_KEY above and the same fixed Qwen3-8B model used by
# Artigen's deep-thinking/directions workflow. Do not silently fall back to a
# different SiliconFlow model.
AGENT_MODEL_PROVIDER=siliconflow
AGENT_MODEL_NAME=Qwen/Qwen3-8B
AGENT_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
AGENT_SILICONFLOW_MAX_TOKENS=4096
AGENT_SILICONFLOW_ENABLE_THINKING=false
AGENT_SILICONFLOW_TIMEOUT_MS=300000
AGENT_SILICONFLOW_MIN_INTERVAL_MS=6500
AGENT_SILICONFLOW_REQUESTS_PER_MINUTE=9
AGENT_SILICONFLOW_INPUT_CREDITS_PER_MILLION=0
AGENT_SILICONFLOW_OUTPUT_CREDITS_PER_MILLION=0
# Runtime V2 readiness rejects zero values above. Keep them at 0 while V2 is disabled;
# configure positive server-side billing rates before enabling V2 in any environment.
AGENT_MODEL_CONTEXT_TOKENS=16384
# Runtime V2 is dark-launched and only affects runs created after enablement.
AGENT_RUNTIME_V2_ENABLED=false
# Runtime availability and traffic assignment are separate. Keep rollout at 0 for
# dark deploys; configured canary users receive V2 before percentage rollout.
AGENT_RUNTIME_V2_ROLLOUT_PERCENT=0
AGENT_RUNTIME_V2_CANARY_USER_IDS=
# Harness V3 only accepts *_test/*_ci databases by default. Set this to 1 only
# for an intentional local-loopback audit run; never enable it in shared/production envs.
AGENT_HARNESS_ALLOW_LOCAL_DATABASE=0
# Remote test databases are also blocked unless this second, narrower opt-in is set.
AGENT_HARNESS_ALLOW_REMOTE_TEST_DATABASE=0
# Live Eval V3.1 is a local DEV-only command. The runner sets both values only
# after loading the exact dev_artigen database and real-provider secrets from
# the macOS Keychain. Never set these on Render, Vercel or a production worker.
AGENT_LIVE_EVAL_MODE=false
AGENT_LIVE_EVAL_ALLOW_REAL_PROVIDER=0
AGENT_LIVE_EVAL_MAX_QWEN_CALLS=200
AGENT_LIVE_EVAL_MAX_KOLORS_CALLS=16
AGENT_LIVE_EVAL_MAX_WALL_CLOCK_MS=28800000
# Keep the Aiven Free DEV campaign pool at or below 3 connections. The signed
# gate and every dispatch require at least 4 application-usable connections
# after PostgreSQL reserved slots are subtracted.
AGENT_LIVE_EVAL_PG_POOL_MAX=3
# Exact local evidence paths used by the signed preflight. The attestation is
# consumed by eval:agent:live:gate; the emitted manifest is consumed by
# eval:agent:live. Both must describe the current clean tracked Git SHA.
AGENT_LIVE_EVAL_GATE_ATTESTATION=
AGENT_LIVE_EVAL_GATE_MANIFEST=
# Store three independent 32-byte keys in the artigen-agent-dev-worker Keychain
# service as AGENT_LIVE_EVAL_GATE_KEY, AGENT_LIVE_EVAL_EVIDENCE_KEY and
# AGENT_LIVE_EVAL_REPORT_KEY. Accepted forms are v1:hex:<64 hex characters> or
# v1:base64:<44-character padded base64>. They are never accepted from this file.
# The report key signs the joined 24-run report + 12-image blind score and the
# owner-canary plan; do not reuse the payload or evidence key.
DESIGN_PLANNER_V2_ENABLED=false
AGENT_ADAPTIVE_REASONING_ENABLED=false
AGENT_PROJECT_MEMORY_ENABLED=false
AGENT_PROVIDER_SCHEDULER_ENABLED=false
# DEV A/B only: stable-v1=.2/.7, exploratory-v1=.4/.8. Production defaults stable.
AGENT_RUNTIME_ACTOR_PROFILE=stable-v1
# Legacy V1 checkpoint compatibility only. Runtime V2 fails closed unless the
# provider/model pair is SiliconFlow + Qwen/Qwen3-8B.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
# Independent 32-byte key. Accepted forms: base64:<value> or hex:<64 chars>.
AGENT_PAYLOAD_ENCRYPTION_KEY=
AGENT_PAYLOAD_KEYCHAIN_SERVICE=
AGENT_PAYLOAD_KEYCHAIN_ACCOUNT=AGENT_PAYLOAD_ENCRYPTION_KEY
AGENT_SANDBOX_PROVIDER=cua
# Local Cua containers do not require an account or CUA_API_KEY.
AGENT_SANDBOX_MODE=local
# Leave blank to use the native platform selected by Cua. Set this only when a
# custom registry image is pinned to a specific architecture.
AGENT_CUA_DOCKER_PLATFORM=
CUA_API_KEY=
# Build once with `pnpm build:cua-image`. This local image derives from Cua
# 0.1.15 and bakes Chromium, LibreOffice, Node and the Python document stack.
# Production cloud deployments should replace it with their independently
# hardened registry image pinned by immutable digest.
AGENT_CUA_IMAGE_REF=artigen/cua-xfce:0.1.15-tools-v2
AGENT_CUA_IMAGE_HAS_TOOLCHAIN=true
# Browser mode remains unavailable unless the active Docker probe verifies this
# proxy-isolated policy. Never set it for a network that has not passed doctor:agent.
AGENT_SANDBOX_EGRESS_POLICY=restricted-v1
AGENT_BROWSER_MODE=full-approval-v1
# Stable per-machine worker ID. Render and this worker share the relay secret;
# on macOS prefer the Keychain service/account fields instead of plaintext.
AGENT_WORKER_ID=artigen-dev-mac-1
AGENT_WORKER_RELAY_URL=ws://127.0.0.1:8080/api/agent-desktop/worker
AGENT_DESKTOP_RELAY_PUBLIC_URL=ws://127.0.0.1:8080/api/agent-desktop/viewer
AGENT_WORKER_RELAY_SECRET=
AGENT_WORKER_RELAY_KEYCHAIN_SERVICE=artigen-agent-dev-relay
AGENT_WORKER_RELAY_KEYCHAIN_ACCOUNT=AGENT_WORKER_RELAY_SECRET
AGENT_SANDBOX_IMAGE_VERSION=artigen-agent-linux-2026-07-01
AGENT_SANDBOX_REGION=us-east-1
CUA_PYTHON=python3.12
AGENT_DEFAULT_MAX_CREDITS=30
AGENT_HARD_MAX_CREDITS=100
AGENT_TRIAL_CREDITS=20
AGENT_DAILY_FREE_CREDITS=0
AGENT_MAX_MINUTES=45
AGENT_MAX_STEPS=120
AGENT_MEMORY_MB=4096
AGENT_DISK_GB=10
AGENT_CPU_COUNT=2
AGENT_RETENTION_DAYS=30
AGENT_WORKER_CONCURRENCY=2
AGENT_WORKER_HEARTBEAT_MS=15000
AGENT_QUEUE_MAX_WAIT_HOURS=24
AGENT_MAX_QUEUED_RUNS=100
AGENT_PGBOSS_POOL_MAX=3
AGENT_QUEUE_RETRY_DELAY_SECONDS=30
AGENT_QUEUE_EXPIRE_SECONDS=3000
# Keep browser omitted until doctor:agent and the real takeover smoke test pass.
AGENT_PUBLIC_CAPABILITIES=files,shell
AGENT_SUBAGENTS_ENABLED=false
AGENT_SUBAGENT_MAX_CONCURRENT=3
AGENT_SUBAGENT_MAX_STEPS=20
AGENT_SUBAGENT_TIMEOUT_MINUTES=10
# Production accepts owner-only-v1 with a database UUID allowlist or
# authenticated-v1 for every active authenticated account.
AGENT_BETA_MODE=disabled
AGENT_BETA_USER_IDS=
DESIGN_CONVERSATION_ENABLED=false
DESIGN_CONVERSATION_WORKER_ENABLED=false
DESIGN_CONVERSATION_AUTO_CREDIT_CAP=50
DESIGN_CONVERSATION_RETENTION_DAYS=30
DESIGN_CONVERSATION_AUTH_IDLE_MINUTES=30
AGENT_OPENAI_INPUT_CREDITS_PER_MILLION=20
AGENT_OPENAI_OUTPUT_CREDITS_PER_MILLION=160
AGENT_SANDBOX_CREDITS_PER_MINUTE=1
AGENT_IMAGE_CREDITS=8
AGENT_IMAGE_REFERENCE_CREDITS=12
# OAuth connectors remain unavailable unless all provider values are present.
AGENT_OAUTH_STATE_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Shared object storage is mandatory before enabling paid image generation.
ASSET_STORAGE_DRIVER=file
ASSET_FILE_ROOT=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=0
# Keep disabled until the S3/R2 staging smoke test passes.
DIRECT_ASSET_UPLOADS=0

# Production email OTP uses a signed HTTPS relay. Render never connects to SMTP directly.
# Brevo remains supported as an optional alternative.
AUTH_EMAIL_OTP_ENABLED=false
MAIL_PROVIDER=relay
MAIL_RELAY_URL=
MAIL_RELAY_SHARED_SECRET=
BREVO_API_KEY=
MAIL_FROM_EMAIL=sorates1997@163.com
MAIL_FROM_NAME=Artigen
MAIL_TIMEOUT_MS=8000
TURNSTILE_REQUIRED=false
TURNSTILE_SECRET_KEY=
# Local development may use localhost. Production requires the exact public
# FQDN from APP_ORIGIN, with no scheme, port, path, wildcard or IP address.
TURNSTILE_HOSTNAMES=localhost

# Optional local-only SMTP fallback. Production deliberately rejects direct SMTP delivery.
QQ_SMTP_USER=
QQ_SMTP_PASS=
QQ_SMTP_HOST=smtp.qq.com
QQ_SMTP_PORT=465
QQ_SMTP_SECURE=true
QQ_SMTP_FROM_NAME=Artigen

# Payment provider (leave paid features disabled until webhook fixtures and staging smoke pass)
AFDIAN_API_USER_ID=
AFDIAN_API_TOKEN=
# The documented Afdian webhook is unsigned. Keep this at 0 and rely on the
# mandatory token-authenticated query-order verification. Set to 1 only if
# Afdian explicitly enables RSA signatures for this creator account.
AFDIAN_WEBHOOK_REQUIRE_SIGN=0
AFDIAN_WEBHOOK_PUBLIC_KEY=
AFDIAN_PACKAGE_PLAN_ID_MAP=
AFDIAN_PACKAGE_PAY_URL_MAP=
