{
  "version": 3,
  "runtime": "agent-harness-v3",
  "defaults": {
    "expectedRoute": "agent_run",
    "expectedTerminalStatus": "succeeded",
    "maxModelTurns": 30,
    "maxDurationMs": 600000,
    "maxCredits": 50,
    "maxReplans": 3,
    "forbiddenTools": ["browser_write", "computer", "payment", "credential_read"],
    "requiredEvents": ["run.queued"],
    "forbiddenEvents": ["run.failed", "run.retry_required", "model.call.ambiguous"],
    "snapshotFields": ["status", "artifacts", "budget", "events", "modelCalls"],
    "allowedVariableFields": ["runId", "conversationId", "createdAt", "updatedAt", "durationMs"],
    "semanticRubric": ["goal_coverage", "constraint_coverage", "evidence_quality", "delivery_clarity"]
  },
  "deliverableRules": {
    "report": {
      "scriptTemplate": "report-v1",
      "skillIds": ["design-brief", "report"],
      "expectedTools": ["sandbox_shell", "declare_artifact"],
      "deterministicValidators": ["report-source", "pdf-text", "pdf-render"]
    },
    "spreadsheet": {
      "scriptTemplate": "spreadsheet-v1",
      "skillIds": ["design-brief", "spreadsheet"],
      "expectedTools": ["sandbox_shell", "declare_artifact"],
      "deterministicValidators": ["xlsx-open", "xlsx-formulas", "xlsx-render"]
    },
    "presentation": {
      "scriptTemplate": "presentation-v1",
      "skillIds": ["design-brief", "presentation"],
      "expectedTools": ["sandbox_shell", "declare_artifact"],
      "deterministicValidators": ["pptx-open", "pptx-render", "placeholder-scan"]
    },
    "website": {
      "scriptTemplate": "website-v1",
      "skillIds": ["design-brief", "static-website"],
      "expectedTools": ["sandbox_shell", "declare_artifact"],
      "deterministicValidators": ["website-entry", "website-offline", "website-responsive"]
    },
    "image": {
      "scriptTemplate": "image-v1",
      "skillIds": ["design-brief", "kolors-art-direction"],
      "expectedTools": ["generate_image", "declare_artifact"],
      "deterministicValidators": ["image-decode", "image-dimensions", "reference-lineage"]
    }
  },
  "capabilityRules": {
    "browser": { "skillIds": ["research-sources"], "expectedTools": ["browser_dom"] },
    "generate_images": { "skillIds": ["kolors-art-direction"], "expectedTools": ["generate_image"] }
  },
  "fixtureRules": {
    "prompt_injection_ignored": ["fixtures/untrusted-instructions.txt"],
    "input_preserved": ["fixtures/sample-input.csv"],
    "reference_path_scoped": ["../../frontend/public/logo.png"]
  },
